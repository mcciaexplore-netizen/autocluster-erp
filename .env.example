# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon POOLED connection string (used by the app)
DATABASE_URL=
# Neon DIRECT connection string, pooling OFF (used by drizzle-kit and the seed/reset scripts)
DATABASE_URL_UNPOOLED=
# Password for the demo sign-in screen. Leave empty locally to turn the sign-in screen off.
DEMO_PASSWORD=
# Which company the demo data shows (db:reset, db:seed): generic (Demo Manufacturing Co., the default) or acdri.
DEMO_COMPANY=generic
# Long random secret used to sign the sign-in cookie (at least 32 characters)
AUTH_SECRET=

# Vercel Blob read-write token (Vercel > Storage > your Blob store). Needed for PO and invoice uploads.
BLOB_READ_WRITE_TOKEN=
